# Base Buildroot defconfig for pi-adas-edge-cloud nodes
# Override per-node specifics in each node's buildroot.config

BR2_arm=y
BR2_ARM_EABIHF=y
BR2_OPTIMIZE_FOR_BUILD=y
BR2_OPTIMIZE_SIZE=y

# Toolchain: glibc required by systemd
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Init system: systemd (matches rootfs overlay and BUILD_STRATEGY.md)
BR2_INIT_SYSTEMD=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_GIT_REPO_URL="https://github.com/raspberrypi/linux.git"
BR2_LINUX_KERNEL_CUSTOM_GIT_VERSION="rpi-6.1.y"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y

BR2_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_USERLAND=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_CLIENTS=y
