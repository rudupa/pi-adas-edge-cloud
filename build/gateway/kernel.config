# Gateway node (Pi 4) full kernel configuration
# BCM2711 / ARMv7l

CONFIG_ARCH_BCM2835=y
CONFIG_SOC_BCM2711=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_GPIO_RASPBERRYPI=y

# WiFi AP
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_NL80211_TESTMODE=y

# Thermal management
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_RASPBERRYPI_HWMON=y
CONFIG_PWM_BCM2835=y

# Hardware video decode
CONFIG_MEDIA_SUPPORT=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEO_RPIVID=m

# Container / security support
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y

# Security hardening
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_DEBUG_RODATA=y
CONFIG_RETPOLINE=y

# I2C / SPI for BrainCraft HAT
CONFIG_I2C_BCM2835=y
CONFIG_SPI_BCM2835=y
