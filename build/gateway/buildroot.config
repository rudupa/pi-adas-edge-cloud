# Gateway node (Pi 4) Buildroot configuration
# ARMv7l / BCM2711 / 4-8 GB RAM — MQTT broker + AI runtime + WiFi AP

BR2_arm=y
BR2_ARM_EABIHF=y
BR2_cortex_a72=y
BR2_OPTIMIZE_FOR_BUILD=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_GIT_REPO_URL="https://github.com/raspberrypi/linux.git"
BR2_LINUX_KERNEL_CUSTOM_GIT_VERSION="rpi-6.1.y"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="../gateway/kernel.config"

BR2_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_USERLAND=y

# MQTT broker
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_CLIENTS=y

# Web server (admin console)
BR2_PACKAGE_NGINX=y

# WiFi AP
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_WPA_SUPPLICANT=y

# AI/ML runtime
BR2_PACKAGE_TENSORFLOW_LITE=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_NUMPY=y

# System tools
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y

# Debugging (disable for production)
BR2_PACKAGE_GDB=y
BR2_PACKAGE_STRACE=y

BR2_ROOTFS_OVERLAY="../gateway/overlay"
BR2_TARGET_ROOTFS_SIZE=512
BR2_TARGET_ROOTFS_SIZE_PERCENTAGE=30
