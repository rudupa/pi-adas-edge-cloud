[Unit]
Description=ADAS UI Display Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/ui-start.sh
ExecStart=/usr/bin/python3 /usr/local/bin/ui-main.py
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=GATEWAY_IP=192.168.4.1

[Install]
WantedBy=multi-user.target
